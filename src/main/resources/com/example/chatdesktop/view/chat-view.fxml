<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/20"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.chatdesktop.controller.ChatController"
        styleClass="root">


    <!-- ========================================================= -->
    <!-- SIDEBAR                                                    -->
    <!-- ========================================================= -->

    <left>

        <VBox
                prefWidth="245"
                minWidth="245"
                maxWidth="245"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="22"
                        right="16"
                        bottom="18"
                        left="16"/>
            </padding>


            <!-- ================================================= -->
            <!-- LOGO / NOME -->
            <!-- ================================================= -->

            <HBox
                    spacing="10"
                    alignment="CENTER_LEFT"
                    styleClass="logo-area">

                <Label
                        text="✦"
                        styleClass="logo-icone"/>

                <VBox
                        spacing="1">

                    <Label
                            text="Assistente"
                            styleClass="sidebar-titulo"/>

                    <Label
                            text="Seu espaço inteligente"
                            styleClass="sidebar-subtitulo"/>

                </VBox>

            </HBox>


            <!-- ================================================= -->
            <!-- ESPAÇO -->
            <!-- ================================================= -->

            <VBox
                    prefHeight="22"
                    minHeight="22"/>


            <!-- ================================================= -->
            <!-- NOVA CONVERSA -->
            <!-- ================================================= -->

            <Button
                    fx:id="botaoNovaConversa"
                    text="＋   Nova conversa"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="botao-nova-conversa"
                    onAction="#novaConversa"/>


            <!-- ================================================= -->
            <!-- HISTÓRICO -->
            <!-- ================================================= -->

            <Label
                    text="HISTÓRICO"
                    styleClass="sidebar-secao"/>


            <ListView
                    fx:id="listaConversas"
                    VBox.vgrow="ALWAYS"
                    styleClass="lista-conversas"/>


            <!-- ================================================= -->
            <!-- PARTE INFERIOR -->
            <!-- ================================================= -->

            <VBox
                    spacing="10"
                    styleClass="sidebar-opcoes">


                <Label
                        text="PREFERÊNCIAS"
                        styleClass="sidebar-secao"/>


                <!-- ================================================= -->
                <!-- BOTÃO TEMA -->
                <!-- ================================================= -->

                <Button
                        fx:id="botaoTema"
                        text="🌙   Tema"
                        maxWidth="Infinity"
                        prefHeight="42"
                        styleClass="botao-tema"
                        onAction="#alternarTema"/>

            </VBox>

        </VBox>

    </left>


    <!-- ========================================================= -->
    <!-- ÁREA PRINCIPAL                                             -->
    <!-- ========================================================= -->

    <center>

        <BorderPane
                styleClass="conteudo-principal">


            <!-- ================================================= -->
            <!-- CABEÇALHO -->
            <!-- ================================================= -->

            <top>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="12"
                        styleClass="header">

                    <VBox
                            spacing="4"
                            HBox.hgrow="ALWAYS">

                        <Label
                                text="✦ Assistente"
                                styleClass="titulo"/>

                        <HBox
                                spacing="7"
                                alignment="CENTER_LEFT"
                                styleClass="status-area">

                            <Label
                                    text="●"
                                    styleClass="online"/>

                            <Label
                                    text="Online"
                                    styleClass="status"/>

                        </HBox>

                    </VBox>


                    <!-- Pequeno indicador visual -->

                    <Label
                            text="IA"
                            styleClass="header-badge"/>

                </HBox>

            </top>


            <!-- ================================================= -->
            <!-- ÁREA DA CONVERSA -->
            <!-- ================================================= -->

            <center>

                <ScrollPane
                        fx:id="scrollChat"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="chat-scroll">

                    <VBox
                            fx:id="messagesBox"
                            spacing="18"
                            styleClass="messages-box">

                        <padding>
                            <Insets
                                    top="30"
                                    right="30"
                                    bottom="30"
                                    left="30"/>
                        </padding>

                    </VBox>

                </ScrollPane>

            </center>


            <!-- ================================================= -->
            <!-- ÁREA DE DIGITAÇÃO -->
            <!-- ================================================= -->

            <bottom>

                <VBox
                        styleClass="input-area">

                    <padding>
                        <Insets
                                top="14"
                                right="22"
                                bottom="18"
                                left="22"/>
                    </padding>


                    <HBox
                            spacing="10"
                            alignment="CENTER"
                            styleClass="input-container">


                        <!-- ================================================= -->
                        <!-- CAMPO -->
                        <!-- ================================================= -->

                        <TextField
                                fx:id="campoMensagem"
                                promptText="Digite sua mensagem..."
                                HBox.hgrow="ALWAYS"
                                prefHeight="46"
                                styleClass="campo-mensagem"
                                onAction="#enviarMensagem"/>


                        <!-- ================================================= -->
                        <!-- ENVIAR -->
                        <!-- ================================================= -->

                        <Button
                                fx:id="botaoEnviar"
                                text="➤"
                                prefWidth="46"
                                prefHeight="46"
                                styleClass="botao-enviar"
                                onAction="#enviarMensagem"/>

                    </HBox>


                    <!-- Pequeno texto inferior -->

                    <Label
                            text="Enter para enviar"
                            styleClass="input-hint"/>

                </VBox>

            </bottom>

        </BorderPane>

    </center>

</BorderPane>