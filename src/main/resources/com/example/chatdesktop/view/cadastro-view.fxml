<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/20"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.chatdesktop.controller.CadastroController"
        alignment="CENTER"
        spacing="15"
        styleClass="login-root">

    <padding>
        <Insets
                top="40"
                right="40"
                bottom="40"
                left="40"
        />
    </padding>


    <!-- TÍTULO -->

    <Label
            text="✦ Criar conta"
            styleClass="login-titulo"
    />

    <Label
            text="Preencha seus dados"
            styleClass="login-subtitulo"
    />


    <!-- NOME -->

    <TextField
            fx:id="campoNome"
            promptText="Nome"
            maxWidth="320"
            styleClass="login-campo"
    />


    <!-- E-MAIL -->

    <TextField
            fx:id="campoEmail"
            promptText="E-mail"
            maxWidth="320"
            styleClass="login-campo"
    />


    <!-- SENHA -->

    <PasswordField
            fx:id="campoSenha"
            promptText="Senha"
            maxWidth="320"
            styleClass="login-campo"
    />


    <!-- CONFIRMAR SENHA -->

    <PasswordField
            fx:id="campoConfirmarSenha"
            promptText="Confirmar senha"
            maxWidth="320"
            styleClass="login-campo"
    />


    <!-- BOTÃO CADASTRAR -->

    <Button
            text="Criar conta"
            prefWidth="320"
            prefHeight="45"
            styleClass="login-botao"
            onAction="#cadastrar"
    />


    <!-- VOLTAR -->

    <Button
            text="Voltar para o login"
            prefWidth="320"
            prefHeight="40"
            styleClass="login-botao-secundario"
            onAction="#voltarLogin"
    />

</VBox>